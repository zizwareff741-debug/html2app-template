<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دردشة - تطبيق تواصل مجاني للأصدقاء</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        :root {
            --primary: #4361ee;
            --secondary: #3f37c9;
            --success: #4cc9f0;
            --light: #f8f9fa;
            --dark: #212529;
            --gray: #6c757d;
            --danger: #e63946;
            --warning: #fca311;
            --info: #4895ef;
            --bg-color: #f0f2f5;
            --sidebar-bg: #ffffff;
            --chat-bg: #ffffff;
            --message-sent: #4361ee;
            --message-received: #e9ecef;
        }
        
        body {
            background-color: var(--bg-color);
            color: var(--dark);
            height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        .container {
            display: flex;
            flex: 1;
            overflow: hidden;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            max-width: 1400px;
            margin: 20px auto;
            border-radius: 15px;
            background-color: var(--sidebar-bg);
        }
        
        /* الشريط الجانبي */
        .sidebar {
            width: 350px;
            background-color: var(--sidebar-bg);
            border-left: 1px solid #e0e0e0;
            display: flex;
            flex-direction: column;
        }
        
        .sidebar-header {
            padding: 20px;
            background-color: var(--primary);
            color: white;
            text-align: center;
            border-radius: 0 15px 0 0;
        }
        
        .sidebar-header h1 {
            font-size: 1.5rem;
            margin-bottom: 5px;
        }
        
        .sidebar-header p {
            font-size: 0.9rem;
            opacity: 0.9;
        }
        
        .user-profile {
            display: flex;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #e0e0e0;
        }
        
        .user-avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background-color: var(--success);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            font-size: 1.2rem;
            margin-left: 10px;
        }
        
        .user-info h3 {
            font-size: 1rem;
            margin-bottom: 5px;
        }
        
        .user-info p {
            font-size: 0.8rem;
            color: var(--gray);
        }
        
        .sidebar-menu {
            padding: 15px 0;
        }
        
        .menu-item {
            display: flex;
            align-items: center;
            padding: 12px 20px;
            cursor: pointer;
            transition: all 0.3s;
            border-right: 3px solid transparent;
        }
        
        .menu-item:hover {
            background-color: rgba(67, 97, 238, 0.1);
            border-right: 3px solid var(--primary);
        }
        
        .menu-item.active {
            background-color: rgba(67, 97, 238, 0.1);
            border-right: 3px solid var(--primary);
            color: var(--primary);
        }
        
        .menu-item i {
            margin-left: 10px;
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
        }
        
        .friends-list {
            flex: 1;
            overflow-y: auto;
            padding: 10px 0;
        }
        
        .friend-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            cursor: pointer;
            transition: all 0.3s;
            border-bottom: 1px solid #f0f0f0;
        }
        
        .friend-item:hover {
            background-color: rgba(67, 97, 238, 0.1);
        }
        
        .friend-item.active {
            background-color: rgba(67, 97, 238, 0.1);
        }
        
        .friend-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--info);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            margin-left: 10px;
        }
        
        .friend-info {
            flex: 1;
        }
        
        .friend-info h4 {
            font-size: 0.9rem;
            margin-bottom: 5px;
        }
        
        .friend-info p {
            font-size: 0.8rem;
            color: var(--gray);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        .friend-status {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background-color: #28a745;
            margin-right: 5px;
        }
        
        .friend-status.offline {
            background-color: var(--gray);
        }
        
        /* منطقة المحادثة */
        .chat-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            background-color: var(--chat-bg);
            border-radius: 0 0 15px 0;
        }
        
        .chat-header {
            padding: 15px 20px;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            background-color: white;
            border-radius: 0 15px 0 0;
        }
        
        .chat-header-info {
            flex: 1;
        }
        
        .chat-header-info h3 {
            font-size: 1.1rem;
            margin-bottom: 5px;
        }
        
        .chat-header-info p {
            font-size: 0.8rem;
            color: var(--gray);
        }
        
        .chat-actions {
            display: flex;
        }
        
        .chat-action-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f0f0f0;
            margin-right: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .chat-action-btn:hover {
            background-color: #e0e0e0;
        }
        
        .messages-container {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            background-color: #f8f9fa;
            display: flex;
            flex-direction: column;
        }
        
        .message {
            max-width: 70%;
            padding: 12px 16px;
            margin-bottom: 15px;
            border-radius: 18px;
            position: relative;
            line-height: 1.4;
        }
        
        .message-sent {
            align-self: flex-end;
            background-color: var(--message-sent);
            color: white;
            border-bottom-right-radius: 5px;
        }
        
        .message-received {
            align-self: flex-start;
            background-color: var(--message-received);
            color: var(--dark);
            border-bottom-left-radius: 5px;
        }
        
        .message-time {
            font-size: 0.7rem;
            opacity: 0.7;
            margin-top: 5px;
            text-align: right;
        }
        
        .message-received .message-time {
            text-align: left;
        }
        
        .message-sender {
            font-weight: bold;
            margin-bottom: 5px;
            font-size: 0.8rem;
        }
        
        .message-input-container {
            padding: 15px 20px;
            background-color: white;
            border-top: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            border-radius: 0 0 15px 0;
        }
        
        .message-input {
            flex: 1;
            padding: 12px 15px;
            border: 1px solid #e0e0e0;
            border-radius: 24px;
            outline: none;
            font-size: 0.9rem;
            transition: all 0.3s;
        }
        
        .message-input:focus {
            border-color: var(--primary);
        }
        
        .send-btn {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background-color: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
        }
        
        .send-btn:hover {
            background-color: var(--secondary);
        }
        
        .attachment-btn {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background-color: #f0f0f0;
            color: var(--gray);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 10px;
            cursor: pointer;
            transition: all 0.3s;
            border: none;
        }
        
        .attachment-btn:hover {
            background-color: #e0e0e0;
        }
        
        /* شاشة تسجيل الدخول */
        .login-container {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            background: linear-gradient(135deg, #4361ee, #3a0ca3);
        }
        
        .login-box {
            background-color: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            width: 400px;
            padding: 30px;
            text-align: center;
        }
        
        .login-box h2 {
            margin-bottom: 10px;
            color: var(--dark);
        }
        
        .login-box p {
            color: var(--gray);
            margin-bottom: 25px;
        }
        
        .form-group {
            margin-bottom: 20px;
            text-align: right;
        }
        
        .form-control {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: all 0.3s;
            direction: rtl;
        }
        
        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 2px rgba(67, 97, 238, 0.2);
        }
        
        .btn {
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
        }
        
        .btn-primary {
            background-color: var(--primary);
            color: white;
            width: 100%;
        }
        
        .btn-primary:hover {
            background-color: var(--secondary);
        }
        
        .btn-link {
            background: none;
            color: var(--primary);
            text-decoration: underline;
            margin-top: 15px;
            display: inline-block;
        }
        
        .divider {
            height: 1px;
            background-color: #e0e0e0;
            margin: 20px 0;
            position: relative;
        }
        
        .divider-text {
            background-color: white;
            padding: 0 10px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: var(--gray);
            font-size: 0.8rem;
        }
        
        .social-login {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
        }
        
        .social-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f0f0f0;
            color: var(--dark);
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .social-btn:hover {
            background-color: #e0e0e0;
            transform: translateY(-2px);
        }
        
        /* التكيف مع الشاشات الصغيرة */
        @media (max-width: 768px) {
            .container {
                flex-direction: column;
                margin: 0;
                border-radius: 0;
                height: 100vh;
            }
            
            .sidebar {
                width: 100%;
                height: auto;
                border-left: none;
                border-bottom: 1px solid #e0e0e0;
            }
            
            .sidebar-header {
                border-radius: 0;
            }
            
            .chat-area {
                border-radius: 0;
            }
            
            .message {
                max-width: 85%;
            }
        }
        
        /* تأثيرات للرسائل الجديدة */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .message {
            animation: fadeIn 0.3s ease-out;
        }
        
        /* تخصيص شريط التمرير */
        ::-webkit-scrollbar {
            width: 6px;
        }
        
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        
        ::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }
        
        ::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }
    </style>
</head>
<body>
    <!-- شاشة تسجيل الدخول (ستظهر أولاً) -->
    <div class="login-container" id="loginScreen">
        <div class="login-box">
            <h2>مرحباً بك في دردشة</h2>
            <p>تطبيق تواصل مجاني للأصدقاء</p>
            
            <form id="loginForm">
                <div class="form-group">
                    <input type="text" class="form-control" placeholder="اسم المستخدم أو البريد الإلكتروني" required>
                </div>
                <div class="form-group">
                    <input type="password" class="form-control" placeholder="كلمة المرور" required>
                </div>
                <button type="submit" class="btn btn-primary">تسجيل الدخول</button>
            </form>
            
            <div class="divider">
                <span class="divider-text">أو</span>
            </div>
            
            <p>ليس لديك حساب؟ <a href="#" class="btn-link" id="showRegister">إنشاء حساب جديد</a></p>
            
            <div class="social-login">
                <div class="social-btn">
                    <i class="fab fa-google"></i>
                </div>
                <div class="social-btn">
                    <i class="fab fa-facebook-f"></i>
                </div>
                <div class="social-btn">
                    <i class="fab fa-twitter"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- تطبيق الدردشة الرئيسي (مخفي في البداية) -->
    <div class="container" id="chatApp" style="display: none;">
        <!-- الشريط الجانبي -->
        <div class="sidebar">
            <div class="sidebar-header">
                <h1><i class="fas fa-comments"></i> دردشة</h1>
                <p>تواصل مع أصدقائك مجاناً</p>
            </div>
            
            <div class="user-profile">
                <div class="user-avatar">م</div>
                <div class="user-info">
                    <h3>محمد أحمد</h3>
                    <p>متصل الآن</p>
                </div>
            </div>
            
            <div class="sidebar-menu">
                <div class="menu-item active">
                    <i class="fas fa-inbox"></i>
                    <span>الرسائل</span>
                </div>
                <div class="menu-item">
                    <i class="fas fa-user-friends"></i>
                    <span>الأصدقاء</span>
                </div>
                <div class="menu-item">
                    <i class="fas fa-users"></i>
                    <span>المجموعات</span>
                </div>
                <div class="menu-item">
                    <i class="fas fa-cog"></i>
                    <span>الإعدادات</span>
                </div>
            </div>
            
            <div class="friends-list">
                <div class="friend-item active">
                    <div class="friend-avatar">س</div>
                    <div class="friend-info">
                        <h4>سارة محمد</h4>
                        <p>مرحباً، كيف حالك؟</p>
                    </div>
                    <div class="friend-status"></div>
                </div>
                
                <div class="friend-item">
                    <div class="friend-avatar">ع</div>
                    <div class="friend-info">
                        <h4>علي حسن</h4>
                        <p>شكراً على المساعدة!</p>
                    </div>
                    <div class="friend-status"></div>
                </div>
                
                <div class="friend-item">
                    <div class="friend-avatar">ف</div>
                    <div class="friend-info">
                        <h4>فاطمة عبدالله</h4>
                        <p>هل يمكننا الاجتماع غداً؟</p>
                    </div>
                    <div class="friend-status offline"></div>
                </div>
                
                <div class="friend-item">
                    <div class="friend-avatar">ي</div>
                    <div class="friend-info">
                        <h4>يوسف خالد</h4>
                        <p>رائع! شكراً لك</p>
                    </div>
                    <div class="friend-status"></div>
                </div>
                
                <div class="friend-item">
                    <div class="friend-avatar">ن</div>
                    <div class="friend-info">
                        <h4>نورة سعيد</h4>
                        <p>أرسلت لك صورة</p>
                    </div>
                    <div class="friend-status"></div>
                </div>
                
                <div class="friend-item">
                    <div class="friend-avatar">أ</div>
                    <div class="friend-info">
                        <h4>أحمد علي</h4>
                        <p>نلتقي في المقهى</p>
                    </div>
                    <div class="friend-status offline"></div>
                </div>
            </div>
        </div>
        
        <!-- منطقة المحادثة -->
        <div class="chat-area">
            <div class="chat-header">
                <div class="chat-header-info">
                    <h3>سارة محمد</h3>
                    <p>متصل الآن</p>
                </div>
                <div class="chat-actions">
                    <div class="chat-action-btn">
                        <i class="fas fa-phone-alt"></i>
                    </div>
                    <div class="chat-action-btn">
                        <i class="fas fa-video"></i>
                    </div>
                    <div class="chat-action-btn">
                        <i class="fas fa-info-circle"></i>
                    </div>
                </div>
            </div>
            
            <div class="messages-container" id="messagesContainer">
                <div class="message message-received">
                    <div class="message-sender">سارة محمد</div>
                    مرحباً محمد! كيف حالك؟
                    <div class="message-time">10:30 ص</div>
                </div>
                
                <div class="message message-sent">
                    الحمد لله بخير، شكراً لسؤالك. كيف حالك أنت؟
                    <div class="message-time">10:31 ص</div>
                </div>
                
                <div class="message message-received">
                    <div class="message-sender">سارة محمد</div>
                    أنا أيضاً بخير الحمد لله. هل انتهيت من المشروع؟
                    <div class="message-time">10:32 ص</div>
                </div>
                
                <div class="message message-sent">
                    نعم، انتهيت منه البارحة. كان صعباً لكنه كان تجربة رائعة.
                    <div class="message-time">10:33 ص</div>
                </div>
                
                <div class="message message-received">
                    <div class="message-sender">سارة محمد</div>
                    هذا رائع! هل يمكنك مساعدتي في مشروعي أيضاً؟
                    <div class="message-time">10:35 ص</div>
                </div>
            </div>
            
            <div class="message-input-container">
                <button class="attachment-btn">
                    <i class="fas fa-paperclip"></i>
                </button>
                <input type="text" class="message-input" placeholder="اكتب رسالة هنا..." id="messageInput">
                <button class="send-btn" id="sendButton">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>

    <script>
        // محاكاة تسجيل الدخول
        document.getElementById('loginForm').addEventListener('submit', function(e) {
            e.preventDefault();
            document.getElementById('loginScreen').style.display = 'none';
            document.getElementById('chatApp').style.display = 'flex';
        });
        
        // إرسال رسالة جديدة
        document.getElementById('sendButton').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });
        
        function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const messageText = messageInput.value.trim();
            
            if (messageText === '') return;
            
            const messagesContainer = document.getElementById('messagesContainer');
            const now = new Date();
            const timeString = now.getHours() + ':' + (now.getMinutes() < 10 ? '0' : '') + now.getMinutes();
            
            const messageElement = document.createElement('div');
            messageElement.className = 'message message-sent';
            messageElement.innerHTML = `
                ${messageText}
                <div class="message-time">${timeString}</div>
            `;
            
            messagesContainer.appendChild(messageElement);
            messageInput.value = '';
            
            // التمرير إلى الأسفل لعرض الرسالة الجديدة
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
            
            // محاكاة رد بعد ثانيتين
            setTimeout(() => {
                const replies = [
                    "هذا مثير للاهتمام!",
                    "أتفق معك تماماً",
                    "هل يمكنك شرح المزيد؟",
                    "شكراً على المعلومة",
                    "رائع! لم أكن أعرف هذا",
                    "سأفكر في هذا الأمر"
                ];
                
                const randomReply = replies[Math.floor(Math.random() * replies.length)];
                
                const replyElement = document.createElement('div');
                replyElement.className = 'message message-received';
                replyElement.innerHTML = `
                    <div class="message-sender">سارة محمد</div>
                    ${randomReply}
                    <div class="message-time">${timeString}</div>
                `;
                
                messagesContainer.appendChild(replyElement);
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }, 2000);
        }
        
        // تغيير الدردشة عند النقر على صديق
        const friendItems = document.querySelectorAll('.friend-item');
        friendItems.forEach(item => {
            item.addEventListener('click', function() {
                friendItems.forEach(f => f.classList.remove('active'));
                this.classList.add('active');
                
                // تغيير اسم المستخدم في رأس المحادثة
                const friendName = this.querySelector('h4').textContent;
                document.querySelector('.chat-header-info h3').textContent = friendName;
                
                // مسح المحادثة الحالية
                const messagesContainer = document.getElementById('messagesContainer');
                messagesContainer.innerHTML = '';
                
                // إضافة رسالة ترحيبية
                const welcomeMessage = document.createElement('div');
                welcomeMessage.className = 'message message-received';
                welcomeMessage.innerHTML = `
                    <div class="message-sender">${friendName}</div>
                    مرحباً! كيف يمكنني مساعدتك؟
                    <div class="message-time">الآن</div>
                `;
                
                messagesContainer.appendChild(welcomeMessage);
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            });
        });
        
        // عرض نموذج التسجيل
        document.getElementById('showRegister').addEventListener('click', function(e) {
            e.preventDefault();
            alert('سيتم فتح نموذج إنشاء حساب جديد. في التطبيق الحقيقي، سيكون هناك نموذج منفصل.');
        });
    </script>
</body>
</html>
